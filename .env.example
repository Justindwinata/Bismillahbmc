# TEMPLATE ONLY — do not put real secrets in the repository
NODE_ENV=development
APP_ENV=local
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://sentinel:CHANGE_ME_LOCAL_ONLY@localhost:5432/sentinel_dev
# Browser connection: only public wallet address is persisted as a nonsecret. Do not supply Phantom seed words.
PUBLIC_SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_HTTP_URL=
SOLANA_RPC_WS_URL=
JUPITER_API_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=
DEX_SCREENER_API_BASE_URL=https://api.dexscreener.com
# Optional model provider. Your ChatGPT Plus subscription does NOT fund runtime API calls.
LLM_ENABLED=false
OPENAI_API_KEY=
# Never store trading private key here; this var is a service endpoint handle, NOT key material.
SIGNER_SERVICE_URL=
SIGNER_SERVICE_AUTH_REF=
LIVE_TRADING_ENABLED=false
SIGNER_ENABLED=false
DEFAULT_MODE=OBSERVE
OWNER_AUTH_REQUIRED=true
SESSION_SECRET=
ALERT_WEBHOOK_URL=
ALLOW_EXTERNAL_TELEMETRY=false
# M0 service-to-service control credential: generate locally, never send to chat.
# Browser sessions/Phantom authentication are not implemented in M0.
SERVICE_AUTH_TOKEN=
# Browser owner auth: set a salted scrypt hash locally; no default owner password.
# For local development, pnpm dev:local generates ignored permission-0600 credentials.
OWNER_PASSWORD_HASH=
WEB_ORIGIN=http://localhost:3000

# Program revision reviews use immutable PostgreSQL registry; no environment hash approval.
